{
  "name": "capacitor-wifiprov",
  "version": "0.1.0",
  "description": "Capacitor bridge for Espressif ESP-IDF network_provisioning over BLE and SoftAP",
  "homepage": "https://github.com/coloz/capacitor-wifiprov#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coloz/capacitor-wifiprov.git"
  },
  "bugs": {
    "url": "https://github.com/coloz/capacitor-wifiprov/issues"
  },
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "dist/",
    "ios/Sources/",
    "Package.swift",
    "CapacitorWifiprov.podspec"
  ],
  "keywords": [
    "capacitor",
    "esp32",
    "espressif",
    "provisioning",
    "ble",
    "softap",
    "wifi"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "npm run clean && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@capacitor/core": "^8.0.0",
    "rimraf": "^6.1.2",
    "rollup": "^4.53.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0 <9.0.0"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}
